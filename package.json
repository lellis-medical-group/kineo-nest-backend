{
  "name": "kineo-nest-backend",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun x tsc",
    "start": "bun dist/main.js",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "lint": "bunx biome check src prisma",
    "lint:fix": "bunx biome check --write src prisma",
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:seed": "bunx --bun prisma db seed"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.26",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/testing": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@prisma/compute-sdk": "latest",
    "@types/bun": "^1.3.14",
    "@types/compression": "^1.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "jest": "^30.4.2",
    "next": "^16.3.4",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  }
}