generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

enum ProfileType {
  INSTALLED
  REPLACEMENT
  BOTH
}

enum Specialty {
  GENERALIST
  DENTIST
  DERMATOLOGIST
  PSYCHIATRIST
  OTHER
}

enum ListingStatus {
  DRAFT
  OPEN
  IN_DISCUSSION
  FULL
  FILLED
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Profile {
  id           String               @id @default(cuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  rppsNumber   String?              @unique
  specialty    Specialty
  profileType  ProfileType
  verified     Boolean              @default(false)
  isPublic     Boolean              @default(true)
  city         String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  practices    Practice[]
  listings     ReplacementListing[] @relation("CreatedListings")
  applications Application[]

  @@map("profile")
}

model Practice {
  id        String               @id @default(cuid())
  ownerId   String
  owner     Profile              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  address   String
  city      String
  latitude  Float?
  longitude Float?
  isPublic  Boolean              @default(true)
  createdAt DateTime             @default(now())
  listings  ReplacementListing[]

  @@index([ownerId])
  @@map("practice")
}

model ReplacementListing {
  id              String        @id @default(cuid())
  practiceId      String
  practice        Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       Profile       @relation("CreatedListings", fields: [createdById], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  specialty       Specialty
  status          ListingStatus @default(DRAFT)
  urgent          Boolean       @default(false)
  description     String?
  maxApplications Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]

  @@index([practiceId])
  @@index([status])
  @@map("replacement_listing")
}

model Application {
  id              String             @id @default(cuid())
  listingId       String
  listing         ReplacementListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicantId     String
  applicant       Profile            @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status          ApplicationStatus  @default(PENDING)
  message         String?
  rejectionReason String?
  withdrawnReason String?
  viewedAt        DateTime?
  respondedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([listingId, applicantId])
  @@index([listingId])
  @@index([applicantId])
  @@map("application")
}
